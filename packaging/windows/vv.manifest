<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest of vv.exe and vvg.exe (embedded by vv.rc.in).
     activeCodePage UTF-8 makes UTF-8 the process code page (Windows 10 1903
     and later), so the narrow-string file APIs that vv, htslib, HDF5 and
     the C runtime call (fopen, open, CreateFileA) take UTF-8 file names, and
     argv arrives in UTF-8. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
