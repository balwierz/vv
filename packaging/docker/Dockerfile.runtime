# Tiny runtime image around the static `vv` binary.
# Build the static binary first via Dockerfile.almalinux8, then:
#   docker build -f packaging/docker/Dockerfile.runtime -t vv:latest .
#
# Note: `vv` is not published on any container registry. There is no
# quay.io/biocontainers/vv image — BioContainers creates those from merged
# Bioconda recipes, and vv's recipe has not been submitted. This Dockerfile
# is the only supported image.

FROM gcr.io/distroless/static-debian12:nonroot

COPY dist/vv /usr/local/bin/vv

ENTRYPOINT ["/usr/local/bin/vv"]
CMD ["--help"]
