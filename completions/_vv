#compdef vv vh
# Zsh tab completion for vv
# Install: place this file as `_vv` in any directory listed in $fpath
# (e.g. /usr/share/zsh/site-functions/_vv).

# Bounded vv invocation for introspecting the file on the command line; a large
# or slow file must never hang the prompt (timeout), and errors are silent.
_vv_run() {
    local vv=${words[1]:-vv}
    if (( $+commands[timeout] )); then
        timeout 1s $vv "$@" 2>/dev/null
    elif (( $+commands[gtimeout] )); then
        gtimeout 1s $vv "$@" 2>/dev/null
    else
        $vv "$@" 2>/dev/null
    fi
}

# The input file already on the command line: the sole positional argument.
# Skip options and the argument of any value-taking option so an output path is
# not mistaken for the input.
_vv_file_arg() {
    local -a valopts
    valopts=(-n -w -c -@ --threads --decode-threads --delimiter --in-delimiter -d --header --color --theme --box
             -r --region --window --regions-file --region-cols --slop --coords
             --tail --sort --tags --expand --parquet --arrow --feather --compression
             --image-mode -f --fasta --select --cols --filter --tab --unique
             --sample)
    local i tok
    for (( i = 2; i < CURRENT; i++ )); do
        tok=$words[i]
        if [[ $tok == -* ]]; then
            (( ${valopts[(I)$tok]} )) && (( i++ ))
            continue
        fi
        [[ -f $tok ]] && { print -r -- $tok; return; }
    done
}

# Complete the file's column names — comma-separated list form (--select etc.).
_vv_columns() {
    local file; file=$(_vv_file_arg)
    [[ -n $file ]] || return 1
    local -a cols; cols=(${(f)"$(_vv_run --list-columns $file)"})
    (( ${#cols} )) || return 1
    _values -s , 'column' $cols
}

# Complete the file's column names — single value (--expand / --filter).
_vv_column() {
    local file; file=$(_vv_file_arg)
    [[ -n $file ]] || return 1
    local -a cols; cols=(${(f)"$(_vv_run --list-columns $file)"})
    (( ${#cols} )) || return 1
    compadd -a cols
}

# Complete the file's component tab names (--tab).
_vv_tabs() {
    local file; file=$(_vv_file_arg)
    [[ -n $file ]] || return 1
    local -a tabs; tabs=(${(f)"$(_vv_run --list-tabs $file)"})
    (( ${#tabs} )) || return 1
    compadd -a tabs
}

_vv() {
    local -a opts file_exts
    file_exts=(
        '*.parquet' '*.arrow' '*.feather' '*.lociss'
        '*.bam' '*.cram' '*.sam'
        '*.vcf' '*.vcf.gz' '*.vcf.zst' '*.bcf'
        '*.gff' '*.gff.gz' '*.gff.zst' '*.gff3' '*.gff3.gz' '*.gff3.zst' '*.gtf' '*.gtf.gz' '*.gtf.zst'
        '*.bed' '*.bed.gz' '*.bed.zst'
        '*.narrowPeak' '*.narrowPeak.gz' '*.narrowPeak.zst'
        '*.broadPeak'  '*.broadPeak.gz'  '*.broadPeak.zst'
        '*.gappedPeak' '*.gappedPeak.gz' '*.gappedPeak.zst'
        '*.bedGraph'   '*.bedGraph.gz'   '*.bedGraph.zst'   '*.bg' '*.bg.gz' '*.bg.zst'
        '*.tagAlign'   '*.tagAlign.gz'   '*.tagAlign.zst'
        '*.tsv' '*.tsv.gz' '*.tsv.zst' '*.csv' '*.csv.gz' '*.csv.zst'
        '*.fa' '*.fa.gz' '*.fasta' '*.fasta.gz'
        '*.fna' '*.fna.gz' '*.faa' '*.faa.gz'
        '*.ffn' '*.ffn.gz' '*.frn' '*.frn.gz'
        '*.fq' '*.fq.gz' '*.fastq' '*.fastq.gz'
        '*.paf' '*.paf.gz' '*.paf.zst'
        '*.json' '*.json.gz' '*.json.zst'
        '*.ndjson' '*.ndjson.gz' '*.ndjson.zst'
        '*.jsonl' '*.jsonl.gz' '*.jsonl.zst'
        '*.bb' '*.bigBed' '*.bigbed' '*.bw' '*.bigWig' '*.bigwig'
        '*.2bit'
        '*.sqlite' '*.sqlite3' '*.db'
        '*.xlsx' '*.xlsm' '*.ods' '*.fods'
        '*.orc' '*.npz' '*.npy'
        '*.pileup' '*.pileup.gz' '*.pileup.zst' '*.mpileup' '*.mpileup.gz' '*.mpileup.zst' '*.pile' '*.pile.gz' '*.pile.zst'
        '*.md' '*.markdown' '*.mdown' '*.mkd'
        '*.txt' '*.txt.gz' '*.txt.zst' '*.text' '*.text.gz' '*.text.zst' '*.log' '*.log.gz' '*.log.zst'
        '*.h5' '*.h5ad' '*.hdf5' '*.loom'
    )

    _arguments -s -S \
        '(- *)'{-h,--help}'[Show help]' \
        '(- *)'{-V,--version}'[Print version]' \
        '(-i --interactive)'{-i,--interactive}'[Open ncurses row browser]' \
        '--no-interactive[Force plain table output]' \
        '(-t --table)'{-t,--table}'[Force plain table output (alias of --no-interactive)]' \
        '--vertical[Transposed (vertical-head) preview]' \
        '-n+[Rows to display]:rows:' \
        '-w+[Max cell width]:width:' \
        '-c+[Max columns]:cols:' \
        '--no-index[Suppress the row-index column]' \
        '(-r --region --window)'{-r,--region,--window}'+[Region (chr:start-end)]:region:' \
        '--regions-file+[BED file with windows]:path:_files' \
        '--region-cols+[chrom,start,end column names (plain Parquet)]:names:_vv_columns' \
        '--slop+[Pad each window by N bp]:n:' \
        '--coords+[Coordinate convention for -r (UCSC default, NCBI = 1-based inclusive)]:kind:(UCSC Kent NCBI GenBank 0-based 1-based bed tabix)' \
        '--tail+[Show the last N rows]:n:' \
        '(-@ --threads)'{-@,--threads}'+[Worker threads]:n:' \
        '--decode-threads+[Arrow CPU pool size for Parquet/CSV decode]:n:' \
        '--color=-[Color mode]:mode:(auto always never)' \
        '--theme+[Color palette]:name:(default dark light solarized-dark solarized-light)' \
        '--box+[Table frame style]:style:(unicode ascii)' \
        '--tsv[Write tab-separated values]' \
        '--csv[Write comma-separated values]' \
        '--delimiter+[Custom output delimiter]:char:' \
        '(-d --in-delimiter)'{-d,--in-delimiter}'+[Input field separator (char or tab/space/comma/semicolon/pipe)]:sep:(tab space comma semicolon pipe)' \
        '--header+[Is the CSV/TSV first row a header?]:mode:(auto on off)' \
        '--no-header[Omit the header row]' \
        '--parquet+[Write a Parquet file]:path:_files' \
        '--arrow+[Write an Arrow IPC file (Feather v2)]:path:_files' \
        '--feather+[Write an Arrow IPC file (Feather v2)]:path:_files' \
        '--compression+[Parquet codec]:codec:(zstd snappy gzip lz4 none)' \
        '--heatmap[Render numeric columns as a terminal heatmap]' \
        '--image-mode+[Heatmap backend]:how:(auto kitty sixel halfblock ascii)' \
        '--json[Write a JSON array]' \
        '--ndjson[Write one JSON object per line]' \
        '--md[Write a GitHub-flavored markdown table]' \
        '--markdown[Alias of --md]' \
        '--validate[Check LociSSD invariants and exit]' \
        '--text[Read the file as plain text whatever its extension]' \
        '--expand+[Unpack a packed key=value column into real columns]:column:_vv_column' \
        '--sort+[Order rows by a column before output (COL or COL:desc)]:column:_vv_column' \
        '--tags+[BAM/CRAM/SAM: add a typed column per aux tag (comma-separated, e.g. NM,AS,RG)]:tags:' \
        '--formats[Print the supported-format table and exit]' \
        '--list-columns[Print column names, one per line, and exit]' \
        '--list-tabs[Print component tab names and exit]' \
        '--decode-pileup[mpileup: explode bases into per-allele counts]' \
        '--pileup[BAM/CRAM: emit mpileup-style per-base rows]' \
        '(-f --fasta)'{-f,--fasta}'[reference FASTA: --pileup ref column + ./, notation, or CRAM decoding]:fasta:_files' \
        '(--select --cols)'{--select,--cols}'+[Project columns: names, globs, N-M ranges, @types, !exclusions]:terms:_vv_columns' \
        '--filter+[Row predicate]:expr:_vv_column' \
        '--schema[Print schema and exit]' \
        '--tab+[View a named component tab (AnnData obs/var/X, sheet)]:name:_vv_tabs' \
        '--describe[Per-column statistics (add --json/--ndjson for machine-readable)]' \
        '--count[Print the row count and exit]' \
        '--stats[Parquet metadata dump]' \
        '--contigs[List reference sequences (name, length) and detect the assembly]' \
        '--gt-stats[VCF/BCF: add per-variant genotype summary columns (het/hom/missing, AC/AN/AF, call_rate)]' \
        '--unique+[Distinct value counts]:cols:' \
        '--distinct[Drop duplicate rows (SQL SELECT DISTINCT), over the shown columns]' \
        '--sample+[Reservoir-sample N rows]:n:' \
        "*:file:_files -g '${(j:|:)file_exts}'"
}

_vv "$@"
